[Unit]
Description=EXHIBITION mode: start the AZ-Epaper hotspot when no router is in reach (radxa-05 only)
# radxa/exhibition-net.sh: waits up to 30 s for a client Wi-Fi profile to
# come up on its own, otherwise `nmcli con up AZ-Epaper`. Enabling this
# unit is "exhibition mode armed" - see radxa/EXHIBITION.md.
After=NetworkManager.service
Wants=NetworkManager.service
Before=epaper-conductor.service

[Service]
Type=oneshot
ExecStart=/bin/bash /home/radxa/E-paper_H_WALL_BRICKS_Raspi/radxa/exhibition-net.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
