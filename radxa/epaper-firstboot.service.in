[Unit]
Description=Derive this unit's static IP from its hostname (cloned Radxa)
# rsetup applies /config/before.txt (hostname, SSH host keys) first;
# the address must follow the final hostname.
After=rsetup.service NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash @REPO_DIR@/radxa/firstboot.sh

[Install]
WantedBy=multi-user.target
