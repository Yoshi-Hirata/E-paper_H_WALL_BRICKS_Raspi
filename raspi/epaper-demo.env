# Arguments for the headless demo service (python -m ui.main).
#
#   --pattern loop   SOLID (6 colours) then RANDOM (6 fields), forever
#   --display null   no screen; --input none: nothing to press
#   --interval       fallback pacing for patterns that do not set their
#                    own (SOLID uses 15 s, RANDOM 20 s)
#
# Every cycle writes both boards' flash, so lengthen the intervals if this
# is going to run unattended for a long time.
DEMO_ARGS=--pattern loop --display null --input none --interval 60 --guard-delay 12
