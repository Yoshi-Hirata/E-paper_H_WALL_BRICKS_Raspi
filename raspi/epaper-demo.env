# Arguments passed to host/wave_demo.py by the epaper-demo systemd service.
#
#   --cycles 0      endless loop (default here for standalone operation)
#   --interval 60   seconds between refreshes; every cycle writes the
#                   boards' flash (slot 19), so keep this generous for
#                   long-term operation
#   --guard-delay   broadcast-stop timing to suppress the factory autoplay
#
DEMO_ARGS=--cycles 0 --interval 60 --guard-delay 12
