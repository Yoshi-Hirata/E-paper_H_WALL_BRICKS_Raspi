# Arguments passed to `python -m ui.main` by the epaper-ui service.
#
#   --display auto   LCD HAT when fitted, PNG frames otherwise
#   --input auto     HAT buttons when available, keyboard otherwise
#                    (under systemd stdin is closed, so keyboard input is
#                    simply inactive - the UI still renders)
#   --interval 60    seconds between panel refreshes (flash wear)
#
UI_ARGS=--display auto --input auto --interval 60 --frames /tmp/epaper-ui
